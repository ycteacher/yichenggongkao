<style id="ui-polish">
/* ===== UI Polish v1 ===== */
.page-shell { -webkit-font-smoothing: antialiased; }

/* 统一圆角与阴影：更轻、更整齐 */
.page-shell .rounded-3xl { border-radius: 16px !important; }
.page-shell .rounded-2xl { border-radius: 12px !important; }
.page-shell [class*="shadow-"] { box-shadow: 0 1px 2px rgba(32,32,32,.04) !important; }

/* 图标统一缩小 */
.page-shell .h-10.w-10, .page-shell .h-11.w-11, .page-shell .h-12.w-12 {
  width: 34px !important; height: 34px !important; border-radius: 10px !important; flex: none;
}
.page-shell .h-10 .material-icons, .page-shell .h-11 .material-icons, .page-shell .h-12 .material-icons { font-size: 17px !important; }
.page-shell .grid .material-icons { font-size: 19px !important; }

/* 三组入口卡改为「图标在左、文字在右」的紧凑行 */
.page-shell .mt-3.grid > button.flex.flex-col[class*="border-[#E5E1D8]"] {
  display: grid !important;
  grid-template-columns: 34px 1fr;
  column-gap: 12px;
  align-items: center;
  padding: 11px 14px !important;
}
.page-shell .mt-3.grid > button.flex.flex-col[class*="border-[#E5E1D8]"] > span:first-child { grid-row: 1 / span 2; grid-column: 1; }
.page-shell .mt-3.grid > button.flex.flex-col[class*="border-[#E5E1D8]"] > p { margin: 0 !important; grid-column: 2; }
.page-shell .mt-3.grid > button.flex.flex-col[class*="border-[#E5E1D8]"] > p:first-of-type { font-size: 14px !important; }
.page-shell .mt-3.grid > button.flex.flex-col[class*="border-[#E5E1D8]"] > p:last-of-type { font-size: 12px !important; margin-top: 2px !important; }

/* 复习建议默认折叠，点一下展开 */
.page-shell [class*="F4F8F3"] {
  position: relative; max-height: 54px; overflow: hidden; cursor: pointer;
  transition: max-height .35s ease;
}
html.review-open .page-shell [class*="F4F8F3"] { max-height: 1600px; }
.page-shell [class*="F4F8F3"]::after {
  content: "展开完整建议 ▾";
  position: absolute; left: 0; right: 0; bottom: 0;
  padding: 16px 0 6px; text-align: center;
  font-size: 11px; font-weight: 500; color: #15803D;
  background: linear-gradient(rgba(244,248,243,0), #F4F8F3 60%);
  pointer-events: none;
}
html.review-open .page-shell [class*="F4F8F3"]::after {
  content: "收起建议 ▴"; background: none; position: static; display: block; padding: 8px 0 0;
}

/* 倒计时卡更挺括 */
.page-shell .mt-5.rounded-3xl { padding: 18px 20px !important; }
.page-shell .mt-5.rounded-3xl [class*="shadow-"] { box-shadow: 0 4px 14px rgba(21,128,61,.22) !important; }

/* 统计卡更轻 */
.page-shell .mt-4.grid.grid-cols-3 > .rounded-3xl { padding: 12px 8px !important; }
.page-shell .mt-4.grid.grid-cols-3 .text-2xl { font-size: 20px !important; }

/* 速算横幅 / 错题本 / 组卷卡收一收 */
.page-shell .mt-4.flex.w-full, .page-shell .mt-3.grid > button[class*="bg-[#"] { padding-top: 13px !important; padding-bottom: 13px !important; }

/* 备考档案卡内边距收紧 */
.page-shell .mt-4.rounded-3xl.p-5 { padding: 16px !important; }
</style>