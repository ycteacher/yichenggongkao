<style>
/* 窄屏顶栏防挤压：品牌行固定，功能按钮换行横向滚动 */
@media (max-width:700px){
  .yc-topbar{flex-wrap:wrap;row-gap:5px;padding-top:8px;padding-bottom:8px}
  .yc-brand{flex:0 0 auto}
  .yc-brand-sub{display:none}
  .yc-brand-name{white-space:nowrap}
  .yc-top-actions{flex:1 1 100%;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none}
  .yc-top-actions::-webkit-scrollbar{display:none}
  body.yc-ui{padding-top:92px!important}
}
</style>