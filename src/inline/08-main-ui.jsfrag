<script>
(function(){
  if (window.__ycUI2) return; window.__ycUI2 = true;

  var PROVINCES = ["北京","天津","河北","山西","内蒙古","辽宁","吉林","黑龙江","上海","江苏","浙江","安徽","福建","江西","山东","河南","湖北","湖南","广东","广西","海南","重庆","四川","贵州","云南","西藏","陕西","甘肃","青海","宁夏","新疆"];
  var TYPES = ["国考","省考","选调生","事业编","军队文职","三支一扶","央国企"];

  var TYPE_ADVICE = {
    "国考": ["行测＋申论，笔试一般在11月底；行测按副省级、地市级、行政执法类分三套卷，题量和难度略有差异。","五大模块里资料分析和判断推理性价比最高，建议每天资料20题、判断15题起步。","申论小题保分、大作文拉差距，每周至少完整写1篇。"],
    "省考": ["多数省份参加多省联考，但江苏、山东、广东、北京、上海等自主命题，卷别和题量差异大，先确定本省卷别再刷题。","先做1-2套本省真题摸底，标出薄弱模块，再按模块专项突破。","关注本省人事考试网公告，招录计划和岗位限制每年都在变。"],
    "选调生": ["以行测＋申论为主，部分省份加考案例分析或公基，整体难度略低于省考。","主要面向应届生，竞争比省考小，但要求党员、学生干部等条件，先核对自己是否符合。","复习节奏可参照省考，重点抓行测五大模块。"],
    "事业编": ["以公基＋职测为主，部分岗位考综合应用能力；全国联考分A-E五类（综合管理、社科专技、自然科学专技、教师、医疗）。","广东等地事业编统考一般不分类别，侧重公基和行测，按本省公告确认考试科目。","公基靠积累，法律、政治、时政是大头，用碎片时间刷常识最划算。"],
    "军队文职": ["公共科目（基本知识＋岗位能力）＋专业科目；岗位能力题型和行测接近。","公共知识里国防、军队常识是特色，占分不低，别只刷行测。","专业科目按报考岗位定，先查岗位表确认考试大纲。"],
    "三支一扶": ["多数省份考公基＋行测或写作，难度低于省考，各省科目不同，以本省公告为准。","服务期满后有定向招录等政策红利，适合作为进入体制的跳板。","复习以公基和行测基础题为主，不必抠难题。"],
    "央国企": ["行测＋综合知识＋专业课，各企业自主命题（如电网、烟草、银行、铁路），题型差异大。","行测是通用硬通货，先按省考标准练五大模块，再补企业特色题。","关注目标企业招聘官网，笔试面试节奏各不相同。"]
  };

  var PROVINCE_NOTES = {
    "江苏": "江苏省考按岗位分A、B、C三类卷（A类综合管理、B类行政执法、C类乡镇机关），行测申论分类命题，先确定自己报的类别再刷题；事业单位统考单独组织，不与省考混用。",
    "广东": "广东省考行测题量大、节奏快，乡镇卷单独命题；事业编统考一般不分类别，侧重公基和行测，按当年公告确认科目。",
    "河南": "河南参加多省联考，报考人数多、行测题量大，务必用整卷模考练节奏，申论同样重点抓。",
    "山东": "山东省考自主命题，题量稳定、竞争激烈，行测要练速度，申论重规范表达。",
    "浙江": "浙江省考自主命题，行测难度偏高，资料分析和数量关系占比大，别放弃数量。",
    "北京": "北京市考自主命题，行测＋申论，部分岗位加专业课，注意公告里的专业考试安排。",
    "上海": "上海市考自主命题，行测＋申论，大部分职位需加考专业课，先定岗位再定复习范围。",
    "四川": "四川参加多省联考，题量中等，竞争比高，行测正确率优先于速度。",
    "湖北": "湖北参加多省联考，行测题量大，按联考节奏准备整卷模考。",
    "湖南": "湖南参加多省联考，行测申论并重，乡镇卷单独命题。",
    "陕西": "陕西参加多省联考，行测数学运算偏难，数量关系量力而行抓基础题。"
  };

  function ls(k, v){ try { if (v === undefined) { var s = localStorage.getItem(k); return s ? JSON.parse(s) : null; } localStorage.setItem(k, JSON.stringify(v)); } catch(e){ return null; } }
  function getState(){ return ls("yc-ui-v1") || {}; }
  function saveState(s){ ls("yc-ui-v1", s); }

  /* ---------- 图标库 ---------- */
  function svg(p, c){ return '<svg class="yc-svg" viewBox="0 0 24 24" fill="none" stroke="' + (c||"currentColor") + '" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">' + p + '</svg>'; }
  /* 图标字体加载失败时会露出英文原名（如 category / library_books），这里按原名全部换成内嵌图标，彻底摆脱字体依赖 */
  var LIG = {
    "category": svg('<rect x="3.5" y="3.5" width="7" height="7" rx="1"/><circle cx="17" cy="7" r="3.5"/><path d="M7 14.5 10.5 21h-7z"/><rect x="14" y="15" width="6" height="6" rx="1"/>'),
    "library_books": svg('<path d="M5 4.5A2.5 2.5 0 0 1 7.5 2H19v17.5H7.5A2.5 2.5 0 0 0 5 22V4.5z"/><path d="M5 19.5A2.5 2.5 0 0 1 7.5 17H19M9.5 7h5"/>'),
    "quiz": svg('<circle cx="12" cy="12" r="9"/><path d="M9.6 9.2a2.5 2.5 0 1 1 3.3 2.4c-.8.3-1.3 1-1.3 1.8v.4"/><path d="M11.6 16.6h.01"/>'),
    "trending_up": svg('<path d="M3 17l6-6 4 4 8-8"/><path d="M14.5 7H21v6.5"/>'),
    "psychology": svg('<path d="M13 3a7 7 0 0 1 4 12.7V19h-3v2h-4v-3l-2.6-.1a1.4 1.4 0 0 1-1.3-1.4V14H4.5l2-3.6A7 7 0 0 1 13 3z"/><path d="M10.5 10.5a2 2 0 1 1 3 1.7c-.7.4-1 .9-1 1.6"/>'),
    "calculate": svg('<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8.5 12h.01M12 12h.01M15.5 12h.01M8.5 16h.01M12 16h.01M15.5 16h.01"/>'),
    "account_balance": svg('<path d="M3 9.5 12 4l9 5.5"/><path d="M5.5 11v7M10 11v7M14 11v7M18.5 11v7M3 21h18"/>'),
    "percent": svg('<path d="M19 5 5 19"/><circle cx="7.5" cy="7.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/>'),
    "menu_book": svg('<path d="M12 6c-1.5-1.3-3.4-2-6-2v14c2.6 0 4.5.7 6 2 1.5-1.3 3.4-2 6-2V4c-2.6 0-4.5.7-6 2z"/><path d="M12 6v14"/>'),
    "history": svg('<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>'),
    "swap_horiz": svg('<path d="M7 8h11M15 4.5 18.5 8 15 11.5M17 16H6M9 12.5 5.5 16 9 19.5"/>'),
    "science": svg('<path d="M10 3v6L4.5 19a2 2 0 0 0 1.8 3h11.4a2 2 0 0 0 1.8-3L14 9V3"/><path d="M8.5 3h7M7.5 15h9"/>'),
    "school": svg('<path d="M2.5 9.5 12 5l9.5 4.5L12 14 2.5 9.5z"/><path d="M6.5 11.5v4.2c0 1.2 2.5 2.6 5.5 2.6s5.5-1.4 5.5-2.6v-4.2"/>'),
    "local_hospital": svg('<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M12 8.5v7M8.5 12h7"/>'),
    "hub": svg('<circle cx="12" cy="12" r="2.5"/><circle cx="5" cy="5" r="2"/><circle cx="19" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="19" r="2"/><path d="M6.6 6.6 10 10M17.4 6.6 14 10M6.6 17.4 10 14M17.4 17.4 14 14"/>'),
    "construction": svg('<path d="M14.7 4.3a5 5 0 0 1 5.6-1l-3.4 3.4 1.4 1.4 3.4-3.4a5 5 0 0 1-6.6 6.2L8 18a2.1 2.1 0 0 1-3-3l7.1-7.1a5 5 0 0 1 2.6-3.6z"/>'),
    "pie_chart": svg('<circle cx="12" cy="12" r="8.5"/><path d="M12 3.5V12l6 6"/>'),
    "payments": svg('<rect x="2.5" y="6.5" width="19" height="11" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 10h.01M18 14h.01"/>'),
    "military_tech": svg('<circle cx="12" cy="9" r="5"/><path d="M9.5 13.5 8 21l4-2.2L16 21l-1.5-7.5"/>'),
    "fact_check": svg('<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 13l2 2 4-4"/>'),
    "emoji_events": svg('<path d="M8 4h8v5a4 4 0 0 1-8 0V4z"/><path d="M8 5H5a3 3 0 0 0 3 4M16 5h3a3 3 0 0 1-3 4M12 13v4M8.5 20h7"/>'),
    "lightbulb": svg('<path d="M9.5 18h5M10 21h4"/><path d="M12 3a6 6 0 0 1 3.4 10.9c-.7.5-1.1 1.3-1.1 2.1v.5h-4.6v-.5c0-.8-.4-1.6-1.1-2.1A6 6 0 0 1 12 3z"/>'),
    "edit_note": svg('<path d="M4 5h10M4 9h16M4 13h16M4 17h7"/><path d="M16.5 19.5 20 16l-2-2-3.5 3.5v2h2z"/>'),
    "download": svg('<path d="M12 3v12M7 10l5 5 5-5"/><path d="M4 21h16"/>'),
    "install_mobile": svg('<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M12 8v6M9.5 11.5 12 14l2.5-2.5"/>'),
    "redeem": svg('<rect x="3.5" y="8" width="17" height="4" rx="1"/><path d="M5 12v8.5h14V12M12 8v12.5"/><path d="M12 8s-1.2-4.5-4.2-4.5a2.2 2.2 0 0 0 0 4.5h4.2zM12 8s1.2-4.5 4.2-4.5a2.2 2.2 0 0 1 0 4.5H12z"/>')
  };
  var ICONS = {
    "module-changshi": svg('<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z"/>'),
    "module-yanyu": svg('<path d="M21 12a8 8 0 0 1-8 8H4l1.6-3.2A8 8 0 1 1 21 12z"/><path d="M8.5 11h7M8.5 14.5h4"/>'),
    "module-shuliang": svg('<rect x="4" y="3" width="16" height="18" rx="3"/><path d="M8 7.5h8M8.5 12h.01M12 12h.01M15.5 12h.01M8.5 16h.01M12 16h.01M15.5 16h.01"/>'),
    "module-panduan": svg('<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1" fill="currentColor"/>'),
    "module-ziliao": svg('<path d="M4 20h16"/><rect x="6" y="11" width="3.4" height="6" rx="1"/><rect x="11" y="7" width="3.4" height="10" rx="1"/><rect x="16" y="4" width="3.4" height="13" rx="1"/>'),
    "module-jundui": svg('<circle cx="12" cy="9" r="5.5"/><path d="M9.5 13.5 8 21l4-2.2L16 21l-1.5-7.5M12 6.8l.9 1.8 2 .3-1.4 1.4.3 2-1.8-1-1.8 1 .3-2-1.4-1.4 2-.3z"/>'),
    "module-jiaoshi": svg('<path d="M2.5 9.5 12 5l9.5 4.5L12 14 2.5 9.5z"/><path d="M6.5 11.5v4.2c0 1.2 2.5 2.6 5.5 2.6s5.5-1.4 5.5-2.6v-4.2M21.5 9.5v5"/>'),
    "module-yiliao": svg('<path d="M12 20.5s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.6a4.3 4.3 0 0 1 7.5 2.9c0 5.4-7.5 10-7.5 10z"/><path d="M9.3 12h5.4M12 9.3v5.4"/>'),
    "guokao-entry": svg('<path d="M4 21V5.5L12 3l8 2.5V21"/><path d="M2.5 21h19M9.5 21v-4.5h5V21M9.5 9h.01M14.5 9h.01M9.5 12.5h.01M14.5 12.5h.01"/>'),
    "zhifa-entry": svg('<path d="M12 3v3M7 6h10M6 6l-3.2 7a3.6 3.6 0 0 0 6.4 0L6 6zM18 6l-3.2 7a3.6 3.6 0 0 0 6.4 0L18 6z"/><path d="M12 6v13M8.5 21h7"/>'),
    "mother-entry": svg('<path d="M5 4.5A2.5 2.5 0 0 1 7.5 2H19v17.5H7.5A2.5 2.5 0 0 0 5 22V4.5z"/><path d="M5 19.5A2.5 2.5 0 0 1 7.5 17H19M9.5 7h5"/>'),
    "countdown-entry": svg('<circle cx="12" cy="13" r="8"/><path d="M12 9v4.5l2.8 1.6M9 2.5h6"/>'),
    "knowledge-entry": svg('<path d="M9 18.5h6M10 21h4"/><path d="M12 3a6 6 0 0 1 3.4 10.9c-.7.5-1.1 1.3-1.1 2.1v.5h-4.6v-.5c0-.8-.4-1.6-1.1-2.1A6 6 0 0 1 12 3z"/>'),
    "plan-entry-grid": svg('<path d="M5 4h14a1.5 1.5 0 0 1 1.5 1.5V20a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 20V5.5A1.5 1.5 0 0 1 5 4z"/><path d="M8 3v3.5M16 3v3.5M3.5 10h17M8 14.5l2.6 2.6 5-5"/>'),
    "speed-calc-entry": svg('<path d="M13 2 4.5 13.5h5L10 22l8.5-11.5h-5L13 2z"/>'),
    "wrong-book-entry": svg('<path d="M4.5 3.5h15v17h-15z" rx="2"/><path d="M4.5 3.5h15v17h-15zM8 3.5v17M11 9l5 5M16 9l-5 5"/>'),
    "start-paper-gk": svg('<path d="M6 2.5h9.5L20 7v14.5H6V2.5z"/><path d="M14.5 2.5V7H20M9 12h6M9 15.5h6"/>'),
    "start-paper-gb": svg('<path d="M6 2.5h9.5L20 7v14.5H6V2.5z"/><path d="M14.5 2.5V7H20M9 12h6M9 15.5h4"/>')
  };

  function replaceIcons(){
    document.querySelectorAll("[data-testid]").forEach(function(el){
      var tid = el.getAttribute("data-testid");
      var ic = ICONS[tid];
      if (!ic) return;
      el.querySelectorAll(".material-icons").forEach(function(mi){
        if (mi.dataset.ycDone) return;
        var wrap = document.createElement("span");
        wrap.innerHTML = ic;
        var s = wrap.firstChild;
        s.dataset.ycDone = "1";
        mi.replaceWith(s);
      });
    });
    /* 全局兜底：凡是写着英文图标名的（字体没加载就会露出来），一律换成内嵌图标 */
    document.querySelectorAll(".material-icons").forEach(function(mi){
      if (mi.dataset.ycDone) return;
      var name = (mi.textContent || "").trim();
      var ic = LIG[name];
      if (!ic) return;
      var wrap = document.createElement("span");
      wrap.innerHTML = ic;
      var s = wrap.firstChild;
      s.dataset.ycDone = "1";
      mi.replaceWith(s);
    });
  }

  /* ---------- 隐藏旧备考档案卡 ---------- */
  function hideProfileCard(){
    document.querySelectorAll(".page-shell > *").forEach(function(el){
      if (el.textContent.indexOf("备考档案") > -1) {
        el.classList.add("yc-hide-profile");
        el.style.display = "none";
      }
    });
  }
  var style = document.createElement("style");
  style.textContent = ".yc-hide-profile{display:none!important}";
  document.head.appendChild(style);

  /* ---------- 顶部栏 ---------- */
  var state = getState();
  var topbar = document.createElement("div");
  topbar.className = "yc-topbar";
  topbar.innerHTML =
    '<div class="yc-brand"><div class="yc-logo"><img src="./assets/icon-yc-red-192.png?v=4" alt="亿成公考" style="width:100%;height:100%;object-fit:cover;display:block;border-radius:11px"></div>' +
    '<div><div class="yc-brand-name">亿成公考 · 备考神器</div>' +
    '<div class="yc-brand-sub">亿成老师团队倾心打造 · 题库持续更新</div></div></div>' +
    '<div class="yc-top-actions">' +
    '<div class="yc-chip" id="ycChipPts"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 15.5s-4.8-3-4.8-6.4A2.7 2.7 0 0 1 12 7.4a2.7 2.7 0 0 1 4.8 1.7c0 3.4-4.8 6.4-4.8 6.4z"/></svg><span id="ycPtsShort">0</span></div>' +
    '<div class="yc-chip" id="ycChipDir"><span id="ycChipDirText">选择方向</span><span class="yc-arrow">▼</span></div>' +
    '</div>';
  document.body.appendChild(topbar);
  document.body.classList.add("yc-ui");

  function refreshChips(){
    var s = getState();
    var t = document.getElementById("ycChipDirText");
    var chip = document.getElementById("ycChipDir");
    if (s.province && s.examType) {
      t.textContent = s.province + " · " + s.examType;
      chip.classList.add("yc-chip-done");
    } else if (s.province) {
      t.textContent = s.province;
      chip.classList.add("yc-chip-done");
    } else {
      t.textContent = "选择方向";
      chip.classList.remove("yc-chip-done");
    }
    renderDirBanner();
  }

  /* ---------- 遮罩 / 面板 / 弹窗 ---------- */
  var mask = document.createElement("div"); mask.className = "yc-mask"; document.body.appendChild(mask);
  var sheet = document.createElement("div"); sheet.className = "yc-sheet"; document.body.appendChild(sheet);
  var modal = document.createElement("div"); modal.className = "yc-modal"; document.body.appendChild(modal);

  function closeAll(){
    mask.classList.remove("on"); sheet.classList.remove("on"); modal.classList.remove("on");
  }
  mask.addEventListener("click", closeAll);

  var pick = {province: null, examType: null};
  function openSheet(){
    var s = getState();
    pick = {province: s.province || null, examType: s.examType || null};
    var pv = PROVINCES.map(function(p){
      return '<div class="yc-opt' + (pick.province === p ? " on" : "") + '" data-pv="' + p + '">' + p + '</div>';
    }).join("");
    var tp = TYPES.map(function(t){
      return '<div class="yc-opt' + (pick.examType === t ? " on" : "") + '" data-tp="' + t + '">' + t + '</div>';
    }).join("");
    sheet.innerHTML =
      '<h3>选择你的备考方向</h3><div class="yc-tip">选好后为你生成针对性复习建议，可随时修改</div>' +
      '<div class="yc-sec"><div class="yc-sec-t">目标省份</div><div class="yc-grid">' + pv + '</div></div>' +
      '<div class="yc-sec"><div class="yc-sec-t">考试类型</div><div class="yc-types">' + tp + '</div></div>' +
      '<button class="yc-save" id="ycSave" ' + ((pick.province && pick.examType) ? "" : "disabled") + '>保存并查看备考建议</button>';
    sheet.querySelectorAll("[data-pv]").forEach(function(el){
      el.addEventListener("click", function(){
        pick.province = el.dataset.pv;
        sheet.querySelectorAll("[data-pv]").forEach(function(e){ e.classList.remove("on"); });
        el.classList.add("on"); syncSave();
      });
    });
    sheet.querySelectorAll("[data-tp]").forEach(function(el){
      el.addEventListener("click", function(){
        pick.examType = el.dataset.tp;
        sheet.querySelectorAll("[data-tp]").forEach(function(e){ e.classList.remove("on"); });
        el.classList.add("on"); syncSave();
      });
    });
    function syncSave(){
      document.getElementById("ycSave").disabled = !(pick.province && pick.examType);
    }
    sheet.querySelector("#ycSave").addEventListener("click", function(){
      saveState(pick); refreshChips(); closeAll();
      setTimeout(openAdvice, 220);
    });
    mask.classList.add("on"); sheet.classList.add("on");
  }

  function openAdvice(){
    var s = getState();
    if (!s.province || !s.examType) { openSheet(); return; }
    var adv = TYPE_ADVICE[s.examType] || [];
    var note = PROVINCE_NOTES[s.province] || ("以" + s.province + "省最新招考公告为准，建议先做1-2套本省真题摸底，标出薄弱模块再专项突破。");
    modal.innerHTML =
      '<h3>你的备考建议</h3>' +
      '<span class="yc-tagline">' + s.province + " · " + s.examType + '</span>' +
      '<div class="yc-adv-block"><h4>' + s.examType + '怎么考</h4><ul>' + adv.map(function(a){ return "<li>" + a + "</li>"; }).join("") + '</ul></div>' +
      '<div class="yc-adv-block"><h4>' + s.province + '特色</h4><div class="yc-adv-note">' + note + '</div></div>' +
      '<button class="yc-close" id="ycAdvClose">知道了，开始刷题</button>';
    document.getElementById("ycAdvClose").addEventListener("click", closeAll);
    mask.classList.add("on"); modal.classList.add("on");
  }

  document.getElementById("ycChipDir").addEventListener("click", function(){
    var s = getState();
    if (s.province && s.examType) openAdvice(); else openSheet();
  });

  /* ---------- 我的方向横幅 ---------- */
  function renderDirBanner(){
    var s = getState();
    var old = document.querySelector(".yc-dir-banner");
    if (old) old.remove();
    if (!s.province || !s.examType) return;
    var shell = document.querySelector(".page-shell");
    if (!shell) return;
    var b = document.createElement("div");
    b.className = "yc-dir-banner";
    b.innerHTML = '<div><div class="yc-db-l">备考方向：' + s.province + " · " + s.examType + '</div>' +
      '<div class="yc-db-s">已按你的方向生成复习建议</div></div>' +
      '<div class="yc-db-r">查看 ›</div>';
    b.addEventListener("click", openAdvice);
    shell.insertBefore(b, shell.firstChild);
  }

  /* ---------- 积分中心 ---------- */
  function getPoints(){ return ls("yicheng-gk-points-v1") || {balance: 0, ledger: []}; }
  function addPoints(amount, reason, detail){
    var p = getPoints();
    p.balance = (p.balance || 0) + amount;
    p.todayEarned = (p.todayEarned || 0) + amount;
    p.todayDate = new Date().toISOString().slice(0, 10);
    p.ledger = p.ledger || [];
    p.ledger.unshift({id: "yc-" + Date.now(), time: new Date().toLocaleString("zh-CN", {hour12: false}).slice(0, 16), amount: amount, reason: reason, detail: detail});
    p.ledger = p.ledger.slice(0, 30);
    ls("yicheng-gk-points-v1", p);
    refreshPtsShort();
  }
  function refreshPtsShort(){
    document.getElementById("ycPtsShort").textContent = getPoints().balance || 0;
  }
  function dailyBonus(){
    var p = getPoints();
    var today = new Date().toISOString().slice(0, 10);
    if (p.todayDate !== today) {
      p.todayEarned = 0; p.todayDate = today;
      ls("yicheng-gk-points-v1", p);
      addPoints(2, "每日打卡", "每日首次打开应用");
    }
  }
  function studyTotals(){
    var s = ls("yicheng-gk-study-v1") || {};
    var mp = s.moduleProgress || {};
    var a = 0, c = 0;
    Object.keys(mp).forEach(function(k){ a += mp[k].answered || 0; c += mp[k].correct || 0; });
    return {a: a, c: c};
  }
  function watchAnswers(){
    var last = studyTotals();
    setInterval(function(){
      var t = studyTotals();
      var da = t.a - last.a, dc = t.c - last.c;
      try{
        if(da>0&&localStorage.getItem('ycgk.refDone')&&!localStorage.getItem('ycgk.refstudyDone')){
          localStorage.setItem('ycgk.refstudyDone','1');
          new Image().src="https://visitor-badge.laobi.icu/badge?page_id=ycgk.refstudy&r="+Date.now();
        }
      }catch(e){}
      if (da > 0) addPoints(da, "完成刷题", "新答 " + da + " 题，每题 +1");
      if (dc > 0) addPoints(dc, "答对加分", "答对 " + dc + " 题，每题 +1");
      last = t;
    }, 4000);
  }
  function openPoints(){
    var p = getPoints();
    var ledger = (p.ledger || []).slice(0, 8).map(function(l){
      return '<div class="yc-ledger-item"><span>' + l.time + " · " + l.reason + '</span><span class="yc-lr">+' + l.amount + "</span></div>";
    }).join("");
    modal.innerHTML =
      '<h3>积分中心</h3><span class="yc-tagline">坚持刷题，积分自然涨</span>' +
      '<div class="yc-pts-hero"><span class="yc-pts-num">' + (p.balance || 0) + '</span><span class="yc-pts-unit">分</span>' +
      '<span class="yc-pts-today">今日 +' + (p.todayEarned || 0) + "</span></div>" +
      '<div class="yc-rules">' +
      '<div class="yc-rule"><b>每日打卡 +2</b><span>每天打开应用自动到账</span></div>' +
      '<div class="yc-rule"><b>刷题 +1 / 答对再 +1</b><span>做完题几秒内自动累计</span></div>' +
      '<div class="yc-rule"><b>连续学习有加成</b><span>连续天数越多，打卡分越高</span></div>' +
      '<div class="yc-rule"><b>兑换商城筹备中</b><span>积分先攒着，商城上线即可兑换</span></div>' +
      "</div>" +
      '<div class="yc-ledger"><div class="yc-sec-t">最近明细</div>' + (ledger || '<div class="yc-ledger-item"><span>暂无记录，去做两道题吧</span><span></span></div>') + "</div>" +
      '<button class="yc-close" id="ycPtsClose">关闭</button>';
    document.getElementById("ycPtsClose").addEventListener("click", closeAll);
    mask.classList.add("on"); modal.classList.add("on");
  }
  document.getElementById("ycChipPts").addEventListener("click", openPoints);

  /* ---------- 资料领取专区卡片 ---------- */
  function addMaterialsCard(){
    if (document.getElementById("yc-materials-card")) return;
    var entry = document.querySelector('[data-testid="papers-entry"]');
    if (!entry) return;
    var card = document.createElement("div");
    card.id = "yc-materials-card";
    card.innerHTML =
      '<span class="yc-mat-ic">' + LIG["redeem"] + '</span>' +
      '<div class="yc-mat-tx"><div class="yc-mat-t">资料领取专区</div>' +
      '<div class="yc-mat-s">预测卷 · 常识100考点 · 临阵磨枪手册 · 免费领取</div></div>' +
      '<span class="yc-mat-go">领取 ›</span>';
    card.addEventListener("click", function(){
      try{ new Image().src = "https://visitor-badge.laobi.icu/badge?page_id=ycgk.materials&r=" + Date.now(); }catch(e){}
      window.location.href = "materials.html";
    });
    entry.parentNode.insertBefore(card, entry);

    /* 安装指引卡片：手机/平板/电脑怎么装到桌面（已装过的用户不再显示） */
    var instDone=false;
    try{ instDone=localStorage.getItem('ycgk.installDone.v1')==='1'; }catch(e){}
    if (!instDone && !document.getElementById("yc-install-card")) {
      var ic = document.createElement("div");
      ic.id = "yc-install-card";
      ic.innerHTML =
        '<span class="yc-mat-ic">' + LIG["install_mobile"] + '</span>' +
        '<div class="yc-mat-tx"><div class="yc-mat-t">安装到桌面</div>' +
        '<div class="yc-mat-s">手机 / 平板 / 电脑 · 一点即开，像 App 一样用</div></div>' +
        '<span class="yc-mat-go">查看 ›</span>';
      ic.addEventListener("click", function(){
        window.location.href = "install.html";
      });
      entry.parentNode.insertBefore(ic, card);
    }
  }

  /* ---------- 内测版横幅（首页顶部） ---------- */
  function addBetaBanner(){
    var shell = document.querySelector(".page-shell");
    if (!shell || document.getElementById("yc-beta-banner")) return;
    if (shell.textContent.indexOf("专项刷题") === -1) return;
    var b = document.createElement("div");
    b.id = "yc-beta-banner";
    b.className = "yc-beta-banner";
    b.innerHTML = '<span class="yc-bb-tag">内测版</span><span class="yc-bb-tx">亿成公考免费使用，第一批使用过的用户永久免费，正式上线之后按月收取会员费</span>';
    shell.insertBefore(b, shell.firstChild);
  }

  /* ---------- 听取意见横幅（首页底部） ---------- */
  function addFbBanner(){
    var shell = document.querySelector(".page-shell");
    if (!shell || document.getElementById("yc-fb-banner")) return;
    if (shell.textContent.indexOf("专项刷题") === -1) return;
    var b = document.createElement("div");
    b.id = "yc-fb-banner";
    b.className = "yc-fb-banner";
    var GIFT_SVGS = {
      humid: '<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="7" width="8" height="13" rx="2"/><path d="M10 4h4"/><path d="M12 11.5c-1.1 1.4-1.7 2.3-1.7 3.1a1.7 1.7 0 1 0 3.4 0c0-.8-.6-1.7-1.7-3.1z"/></svg>',
      pad: '<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4.5" y="3" width="15" height="18" rx="2.5"/><path d="M10 17.5h4"/></svg>',
      phone: '<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="7.5" y="2.5" width="9" height="19" rx="2.5"/><path d="M10.5 18.5h3"/></svg>',
      book: '<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5.5C10.5 4.2 8.6 3.5 6 3.5v14c2.6 0 4.5.7 6 2 1.5-1.3 3.4-2 6-2v-14c-2.6 0-4.5.7-6 2z"/><path d="M12 5.5v14"/></svg>'
    };
    b.innerHTML = '<div style="min-width:0"><div class="yc-fb-l">听取意见 · 填问卷拿礼品</div><div class="yc-fb-s">1 分钟匿名问卷 · 积分可换真题卷、考公书籍、小家电、平板、手机</div>' +
      '<div class="yc-gifts">' +
      '<span class="yc-gift">' + GIFT_SVGS.humid + '<b>加湿器</b></span>' +
      '<span class="yc-gift">' + GIFT_SVGS.pad + '<b>平板</b></span>' +
      '<span class="yc-gift">' + GIFT_SVGS.phone + '<b>手机</b></span>' +
      '<span class="yc-gift">' + GIFT_SVGS.book + '<b>考公书籍</b></span>' +
      '</div></div><span class="yc-fb-r">去填写 ›</span>';
    b.addEventListener("click", function(){
      try{ new Image().src = "https://visitor-badge.laobi.icu/badge?page_id=ycgk.feedback&r=" + Date.now(); }catch(e){}
      window.location.href = "feedback.html";
    });
    shell.appendChild(b);
  }

  /* ---------- 视频讲解横幅（首页底部） ---------- */
  function addVideoBanner(){
    var shell = document.querySelector(".page-shell");
    if (!shell || document.getElementById("yc-video-banner")) return;
    if (shell.textContent.indexOf("专项刷题") === -1) return;
    var b = document.createElement("div");
    b.id = "yc-video-banner";
    b.className = "yc-video-banner";
    b.innerHTML = '<div style="min-width:0"><div class="yc-vb-l">📺 视频讲解</div>' +
      '<div class="yc-vb-s">亿成老师精讲视频 · 配套试卷可保存打印，边看边学</div></div>' +
      '<span class="yc-vb-r">去看 ›</span>';
    b.addEventListener("click", function(){
      window.location.href = "videos.html?v=8";
    });
    var fb = document.getElementById("yc-fb-banner");
    if (fb) shell.insertBefore(b, fb); else shell.appendChild(b);
  }

  /* ---------- 启动 ---------- */
  function boot(){
    replaceIcons(); hideProfileCard(); refreshChips(); refreshPtsShort(); dailyBonus(); watchAnswers();
    function tagGrids(){
    document.querySelectorAll(".page-shell .grid.grid-cols-2").forEach(function(g){
      if (g.textContent.indexOf("国考专题页") > -1) g.classList.add("yc-grid-3");
    });
  }
  var mo = new MutationObserver(function(){ replaceIcons(); hideProfileCard(); tagGrids(); addMaterialsCard(); addBetaBanner(); addFbBanner(); addVideoBanner(); });
    mo.observe(document.body, {childList: true, subtree: true});
    addMaterialsCard(); addBetaBanner(); addFbBanner(); addVideoBanner();
  }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot);
  else boot();
  /* 供邀请好友积分模块调用 */
  window.getPoints = getPoints;
  window.addPoints = addPoints;
})();
</script>