<script>
/* material-icons 兜底 v3 —— 无条件激活，彻底不依赖字体检测
   历史问题：v1改textContent与React打架闪烁；v2用fontWorks测量法检测，但iPad/部分WebView
   测量失准→兜底不激活→连字裸奔成 group/home 等英文。
   v3：不再检测，页面加载即注入CSS(emoji覆盖+英文透明)，并持续给动态图标补data-emoji。
   字体正常时图标也被透明化、统一显示emoji，视觉一致，永不露英文。 */
(function(){
  var MAP={
    apartment:'🏢',account_balance:'🏦',school:'🎓',military_tech:'🎖️',
    group:'👥',group_add:'👥',groups:'👥',people:'👥',redeem:'🎁',
    install_mobile:'📲',download:'📥',functions:'➗',gesture:'👆',
    home:'🏠',history_edu:'📜',assignment:'📋',star:'⭐',star_border:'☆',
    arrow_back:'←',arrow_forward:'→',chevron_right:'›',chevron_left:'‹',expand_more:'⌄',expand_less:'⌃',
    check:'✓',check_circle:'✅',check_circle_outline:'☑️',task_alt:'✅',
    close:'✕',cancel:'✕',clear:'✕',search:'🔍',edit:'✏️',edit_note:'📝',
    delete_sweep:'🗑️',lightbulb:'💡',tips_and_updates:'💡',bolt:'⚡',
    auto_awesome:'✨',gavel:'⚖️',flag:'🚩',event:'📅',fact_check:'📋',
    grid_on:'▦',account_tree:'🌳',speed:'⚡',target:'🎯',tracking:'🎯',
    keyboard:'⌨️',warning:'⚠️',error:'❗',checklist:'📋',badge:'🏅',
    comment:'💬',sync:'🔄',repeat:'🔁',undo:'↩️',upload:'⬆️',
    cleaning_services:'🧹',hand:'✋',list:'📃',paper:'📄',folder:'📁',
    description:'📄',menu_book:'📖',quiz:'❓',help:'❓',info:'ℹ️',
    person:'👤',account_circle:'👤',work:'💼',business:'🏢',
    date_range:'📅',calendar_month:'📅',schedule:'⏰',trending_up:'📈',
    bar_chart:'📊',pie_chart:'🥧',dashboard:'📊',data_usage:'📊',
    emoji_events:'🏆',military:'🎖️',local_hospital:'🏥',
    phone_android:'📱',devices:'💻',laptop:'💻',computer:'💻',
    lock:'🔒',security:'🔐',verified:'✅',star_rate:'⭐',
    more_horiz:'⋯',more_vert:'⋮',add:'➕',remove:'➖',
    play_arrow:'▶️',pause:'⏸️',refresh:'🔄',send:'📤',
    analytics:'📊',insights:'💡',summarize:'📋',article:'📄'
  };
  var SEL='.material-icons,.material-icons-outlined,.material-icons-round,.material-icons-sharp,.material-icons-two-tone';
  function emoji(name){ return MAP[name] || '•'; }
  function keyOf(name){
    if(MAP[name]) return name;
    for(var k in MAP){ if(MAP[k]===name) return k; }
    return name;
  }
  function tagOne(el){
    if(!el || el.nodeType!==1 || el.getAttribute('data-emoji')) return;
    var name=(el.textContent||'').trim();
    if(!name) return;
    el.setAttribute('data-emoji', emoji(keyOf(name)));
  }
  function tagAll(){ try{ document.querySelectorAll(SEL).forEach(tagOne); }catch(e){} }
  function activate(){
    if(document.getElementById('yc-icon-emoji-css')) return;
    var css=document.createElement('style');
    css.id='yc-icon-emoji-css';
    css.textContent=
      /* 英文连字透明化，emoji用::after显示；font-size归零藏原文 */
      'html.yc-emoji-mode '+SEL+'{font-size:0!important;line-height:1!important;color:inherit!important;}'+
      'html.yc-emoji-mode '+SEL+'::after{content:attr(data-emoji);font-size:20px;line-height:1;font-family:system-ui,-apple-system,"Segoe UI Emoji","Apple Color Emoji",sans-serif;}'+
      'html.yc-emoji-mode '+SEL+':not([data-emoji])::after{content:"•";}'+
      'html.yc-emoji-mode .yc-tabbar '+SEL+'::after{font-size:22px;}'+
      'html.yc-emoji-mode .yc-mat-ic::after,html.yc-emoji-mode .yc-share-ic::after{font-size:26px;}'+
      'html.yc-emoji-mode .yc-top-actions '+SEL+'::after{font-size:18px;}';
    document.head.appendChild(css);
    document.documentElement.classList.add('yc-emoji-mode');
    tagAll();
    /* 持续补 data-emoji：React动态渲染的新图标 */
    try{
      var mo=new MutationObserver(function(list){
        list.forEach(function(r){
          if(r.type==='attributes'){ if(r.target&&r.target.matches) tagOne(r.target); return; }
          r.addedNodes.forEach(function(n){
            if(n.nodeType===1){
              if(n.matches&&n.matches(SEL)) tagOne(n);
              if(n.querySelectorAll) n.querySelectorAll(SEL).forEach(tagOne);
            }
          });
          /* 文本节点变化(React改children英文)时重新打标记 */
          if(r.target&&r.target.nodeType===1&&r.target.matches&&r.target.matches(SEL)) tagOne(r.target);
        });
      });
      mo.observe(document.documentElement,{childList:true,subtree:true,characterData:true,attributes:true,attributeFilter:['class']});
    }catch(e){}
    /* 高频定时兜底：前10秒每200ms，之后每1秒，确保覆盖所有重渲染 */
    var fast=0;
    var ivFast=setInterval(function(){ tagAll(); if(++fast>50)clearInterval(ivFast); },200);
    setInterval(tagAll,1000);
  }
  /* DOM就绪即无条件激活，不等字体检测 */
  if(document.documentElement) activate();
  else document.addEventListener('DOMContentLoaded',activate);
})();
</script>
