<script>
/* material-icons 字体加载失败兜底 v2：
   旧方案改 textContent 会和 React 重渲染打架→闪烁(截图emoji、平时英文)。
   新方案：给图标元素打 data-emoji 属性，用 CSS ::after 显示 emoji、font-size:0 藏英文原文。
   React 重渲染只改 textContent(英文)，改不动 data-emoji 属性和 CSS 显示→彻底消除闪烁。 */
(function(){
  var MAP={
    apartment:'🏢',account_balance:'🏦',school:'🎓',military_tech:'🎖️',
    group_add:'👥',groups:'👥',redeem:'🎁',install_mobile:'📲',download:'📥',
    home:'🏠',history_edu:'📜',assignment:'📋',star:'⭐',star_border:'☆',
    arrow_back:'←',arrow_forward:'→',chevron_right:'›',chevron_left:'‹',expand_more:'⌄',expand_less:'⌃',
    check:'✓',check_circle:'✅',check_circle_outline:'☑️',task_alt:'✅',
    close:'✕',cancel:'✕',clear:'✕',search:'🔍',edit:'✏️',edit_note:'📝',
    delete_sweep:'🗑️',lightbulb:'💡',tips_and_updates:'💡',bolt:'⚡',
    auto_awesome:'✨',gavel:'⚖️',flag:'🚩',event:'📅',fact_check:'📋',
    grid_on:'▦',account_tree:'🌳',speed:'⚡',target:'🎯',tracking:'🎯',
    keyboard:'⌨️',warning:'⚠️',error:'❗',checklist:'📋',badge:'🏅',
    comment:'💬',sync:'🔄',repeat:'🔁',undo:'↩️',upload:'⬆️',
    cleaning_services:'🧹',hand:'✋',list:'📃',paper:'📄',folder:'📁',
    description:'📄',menu_book:'📖',quiz:'❓',help:'❓',info:'ℹ️',
    person:'👤',account_circle:'👤',people:'👥',work:'💼',business:'🏢'
  };
  var SEL='.material-icons,.material-icons-outlined,.material-icons-round,.material-icons-sharp,.material-icons-two-tone';
  var tried=0, active=false, done=false;
  function emoji(name){ return MAP[name] || '•'; }

  // 测量法判断 Material Icons 字体是否真的渲染成图标
  function fontWorks(){
    try{
      var m=document.createElement('span');
      m.style.cssText='position:absolute;left:-9999px;top:0;font-family:"Material Icons";font-size:40px;font-feature-settings:"liga";white-space:nowrap;';
      m.textContent='home';
      var t=document.createElement('span');
      t.style.cssText='position:absolute;left:-9999px;top:0;font-family:serif;font-size:40px;white-space:nowrap;';
      t.textContent='home';
      document.body.appendChild(m);document.body.appendChild(t);
      var a=m.getBoundingClientRect().width,b=t.getBoundingClientRect().width;
      document.body.removeChild(m);document.body.removeChild(t);
      return Math.abs(a-b)>3;
    }catch(e){ return false; }
  }
  // 反查：若 textContent 已是 emoji(旧脚本留痕)，找回对应连字名
  function keyOf(name){
    if(MAP[name]) return name;
    for(var k in MAP){ if(MAP[k]===name) return k; }
    return name;
  }
  function tagOne(el){
    if(!el || el.nodeType!==1 || el.getAttribute('data-emoji')) return;
    var name=(el.textContent||'').trim();
    if(!name) return;
    el.setAttribute('data-emoji', emoji(keyOf(name)));
  }
  function tagAll(){
    try{ document.querySelectorAll(SEL).forEach(tagOne); }catch(e){}
  }
  function activate(){
    if(active) return; active=true;
    var css=document.createElement('style');
    css.id='yc-icon-emoji-css';
    css.textContent=
      'html.yc-emoji-mode '+SEL+'{font-size:0!important;line-height:1!important;}'+
      'html.yc-emoji-mode '+SEL+'::after{content:attr(data-emoji);font-size:20px;line-height:1;font-family:system-ui,-apple-system,"Segoe UI Emoji","Apple Color Emoji",sans-serif;}'+
      'html.yc-emoji-mode .yc-tabbar '+SEL+'::after{font-size:22px;}'+
      'html.yc-emoji-mode .yc-mat-ic::after,html.yc-emoji-mode .yc-share-ic::after{font-size:26px;}';
    document.head.appendChild(css);
    document.documentElement.classList.add('yc-emoji-mode');
    tagAll();
    // React 动态渲染的新图标：持续补 data-emoji 属性
    try{
      var mo=new MutationObserver(function(list){
        list.forEach(function(r){
          r.addedNodes.forEach(function(n){
            if(n.nodeType===1){
              if(n.matches&&n.matches(SEL)) tagOne(n);
              if(n.querySelectorAll) n.querySelectorAll(SEL).forEach(tagOne);
            }
          });
        });
      });
      mo.observe(document.documentElement,{childList:true,subtree:true});
    }catch(e){}
    // 定时兜底：覆盖 React 反复重渲染，确保每个图标都有 data-emoji
    var ticks=0;
    var iv=setInterval(function(){ tagAll(); if(++ticks>40) clearInterval(iv); }, 500);
    done=true;
  }
  function attempt(){
    tried++;
    if(fontWorks()) return;
    if(tried>=3){ activate(); return; }
    setTimeout(attempt, 600);
  }
  function boot(){
    if(document.readyState==='loading'){
      document.addEventListener('DOMContentLoaded',function(){ setTimeout(attempt,300); });
    } else { setTimeout(attempt,300); }
    setTimeout(function(){ if(!done) activate(); }, 4000);
  }
  boot();
})();
</script>
