<script>
/* 刷满10分钟弹问卷邀请：礼品=专业老师一对一问诊1小时。每人只弹一次。 */
(function(){
  var DONE='ycgk.fbinvite.done', ACC='ycgk.fbinvite.sec';
  try{if(localStorage.getItem(DONE))return}catch(e){return}
  var acc=0,last=Date.now(),timing=false;
  try{acc=parseInt(localStorage.getItem(ACC)||'0',10)||0}catch(e){}
  function tick(){
    var now=Date.now();
    if(!document.hidden&&timing){ acc+=Math.min(10,Math.round((now-last)/1000)); }
    last=now;
    try{localStorage.setItem(ACC,String(acc))}catch(e){}
    if(acc>=600){ showInvite(); }
  }
  /* 用户点了刷题按钮后开始计时 */
  document.addEventListener('click',function(e){
    if(timing)return;
    var el=e.target;while(el&&el!==document.body&&el.tagName!=='BUTTON')el=el.parentElement;
    if(!el||el===document.body)return;
    var t=(el.innerText||el.textContent||'').replace(/\s+/g,'');
    if(/(顺序刷|随机刷|开始刷题|继续刷题|第\d+套$)/.test(t)){timing=true;last=Date.now();}
  },true);
  setInterval(tick,1000);
  function showInvite(){
    try{localStorage.setItem(DONE,'1')}catch(e){}
    try{new Image().src="https://visitor-badge.laobi.icu/badge?page_id=ycgk.fbinvite&r="+Date.now()}catch(e){}
    var ov=document.createElement('div');
    ov.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:10000;display:flex;align-items:center;justify-content:center;padding:22px;opacity:0;transition:opacity .25s';
    ov.innerHTML='<div style="background:#fff;border-radius:20px;width:100%;max-width:400px;padding:26px 22px 22px;box-shadow:0 16px 48px rgba(0,0,0,.28);position:relative;text-align:center">'+
      '<button id="ycFbX" style="position:absolute;top:12px;right:16px;font-size:24px;color:#aaa;background:none;border:none;line-height:1">×</button>'+
      '<div style="font-size:34px;line-height:1">🎁</div>'+
      '<h3 style="font-size:20px;color:#15803D;margin:10px 0 8px;font-weight:800">刷题辛苦了，帮个小忙？</h3>'+
      '<p style="font-size:14px;color:#555;line-height:1.75;margin:0 0 14px">你已经认真刷了 10 分钟啦 👏<br>花 1 分钟填个<b>小问卷</b>，告诉我们哪里还能做得更好。</p>'+
      '<div style="background:linear-gradient(135deg,#FFF7ED,#FEF3C7);border:1px solid #FCD34D;border-radius:14px;padding:14px;margin-bottom:16px">'+
        '<div style="font-size:13px;color:#92400E;margin-bottom:4px">填写即可参与抽取</div>'+
        '<div style="font-size:16px;color:#B45309;font-weight:800;line-height:1.5">🎓 专业老师 1 对 1 问诊 1 小时</div>'+
        '<div style="font-size:12px;color:#92400E;margin-top:4px">考前政策解读 · 报考指导 · 备考答疑</div>'+
      '</div>'+
      '<a href="./feedback.html" style="display:block;width:100%;background:#15803D;color:#fff;border-radius:12px;padding:14px;font-size:16px;font-weight:800;text-decoration:none">去填问卷 · 抽问诊名额</a>'+
      '<button id="ycFbNo" style="display:block;width:100%;background:none;border:none;color:#999;font-size:13px;margin-top:12px">下次再说</button>'+
      '</div>';
    document.body.appendChild(ov);
    setTimeout(function(){ov.style.opacity='1'},10);
    function close(){ov.style.opacity='0';setTimeout(function(){ov.remove()},250)}
    ov.querySelector('#ycFbX').onclick=close;
    ov.querySelector('#ycFbNo').onclick=close;
    ov.addEventListener('click',function(e){if(e.target===ov)close()});
  }
})();
</script>