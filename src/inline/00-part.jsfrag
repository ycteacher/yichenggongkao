<script>
    /* ===== COS 加速：静态大文件走腾讯云 COS（国内节点），失败自动回退本站地址 =====
       ycAsset('./assets/xxx.js') 返回 COS 完整地址；COS 不可用时各加载点回退 './' 原地址。 */
    window.__YC_CDN = 'https://yichenggongkao-1538963435.cos.ap-beijing.myqcloud.com';
    window.ycAsset = function(p){
      try{ return window.__YC_CDN + '/' + String(p).replace(/^\.\//,''); }catch(e){ return p; }
    };
    /* ===== 修改点②：新增 ycFetch 请求兜底 + 题库失败占位 =====
       8 秒超时（AbortController）+ 失败自动重试 1 次；两次都失败时回调 onFail，
       由调用方渲染「加载失败，点击重试」占位，禁止任何自动循环 reload。 */
    window.ycFetch = function(url, opts, onFail){
      opts = opts || {};
      function once(){
        var ctl = new AbortController();
        var timer = setTimeout(function(){ ctl.abort(); }, 8000);
        var o = {};
        for(var k in opts){ o[k] = opts[k]; }
        o.signal = ctl.signal;
        return fetch(url, o).then(function(r){
          clearTimeout(timer);
          if(!r.ok){ throw new Error('HTTP ' + r.status); }
          return r;
        }, function(err){
          clearTimeout(timer);
          throw err;
        });
      }
      return once().catch(function(e1){
        return new Promise(function(resolve, reject){
          setTimeout(function(){
            once().then(resolve, function(e2){
              try{ onFail && onFail(e2); }catch(_){}
              reject(e2);
            });
          }, 1200);
        });
      });
    };
    /* 题库索引两次都失败时的占位块：用户点击才重试，不自动循环 */
    window.__ycBankFail = function(retry){
      if(document.getElementById('yc-bank-fail')) return;
      var d = document.createElement('div');
      d.id = 'yc-bank-fail';
      d.style.cssText = 'position:fixed;inset:0;z-index:9998;background:#FAF8F2;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px';
      d.innerHTML = '<div style="font-size:15px;color:#4A463F">题库加载失败，请检查网络后重试</div>'
        + '<button id="yc-bank-retry" style="padding:10px 28px;border:none;border-radius:999px;background:#DC2626;color:#fff;font-size:15px;font-weight:600">点击重试</button>';
      document.body.appendChild(d);
      document.getElementById('yc-bank-retry').addEventListener('click', function(){
        try{ sessionStorage.setItem('yc-skip-cdn','1'); }catch(e){}
        d.parentNode && d.parentNode.removeChild(d);
        retry && retry();
      });
    };
    </script>
<script>
    (function(){
      /* 版本统一来源：assets/qbank-index.json 的 v 字段；禁止在页面多处手写版本号 */
      try{
        var K="yc-page-ver";
        var FALLBACK="tt62"; /* 兜底：仅首次访问且索引请求失败时使用 */
        function fixIcons(v){
          try{
            var i1=document.querySelector('link[rel="icon"]'),i2=document.querySelector('link[rel="apple-touch-icon"]'),og=document.querySelector('meta[property="og:image"]');
            [i1,i2].forEach(function(el){ if(el&&el.href) el.href=el.href.replace(/\?v=[^&"]*/,'?v='+v); });
            if(og&&og.content) og.content=og.content.replace(/\?v=[^&"]*/,'?v='+v);
          }catch(e){}
        }
        function applyV(v){
          try{
            var sc=document.createElement('script');
            sc.type='module';sc.crossOrigin='';
            sc.src=(window.ycAsset&&!ycSkipCdn()?window.ycAsset('./assets/index-b34.js'):'./assets/index-b34.js')+'?v='+v;
            sc.onerror=function(){ try{ var s2=document.createElement('script'); s2.type='module'; s2.crossOrigin=''; s2.src='./assets/index-b34.js?v='+v; document.head.appendChild(s2); }catch(e){} };
            document.head.appendChild(sc);
            var lk=document.createElement('link');
            lk.rel='stylesheet';lk.crossOrigin='';
            lk.href=(window.ycAsset&&!ycSkipCdn()?window.ycAsset('./assets/index-C2M5URtc.css'):'./assets/index-C2M5URtc.css')+'?v='+v;
            lk.onerror=function(){ try{ var l2=document.createElement('link'); l2.rel='stylesheet'; l2.crossOrigin=''; l2.href='./assets/index-C2M5URtc.css?v='+v; document.head.appendChild(l2); }catch(e){} };
            document.head.appendChild(lk);
            if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded',function(){ fixIcons(v); }); }
            else { fixIcons(v); }
          }catch(e){}
        }
        var cached=localStorage.getItem(K);
        if(cached) applyV(cached);
        /* 修改点：索引请求改为 CDN 与本站并行赛跑（谁先返回用谁），替代原「CDN 失败再试本站」串行回退；
           本站请求经 SW 缓存优先，命中秒回。用户点过「重试」后本会话跳过 CDN 直连本站（yc-skip-cdn）。 */
        function ycSkipCdn(){ try{ return sessionStorage.getItem('yc-skip-cdn')==='1'; }catch(e){ return false; } }
        function ycIdxUrls(){
          var u=(window.ycAsset?window.ycAsset('./assets/qbank-index.json'):'./assets/qbank-index.json');
          if(ycSkipCdn()||u.indexOf(location.origin)===0) return [u];
          return [u,'./assets/qbank-index.json'];
        }
        function ycRaceIdx(urls){
          return new Promise(function(resolve,reject){
            var done=false,fails=0;
            urls.forEach(function(u){
              window.ycFetch(u,{cache:"no-store"}).then(function(r){
                if(done){ return; }
                done=true;resolve(r);
              }).catch(function(){ fails++; if(fails===urls.length&&!done){ reject(new Error('all-index-src-fail')); } });
            });
          });
        }
        ycRaceIdx(ycIdxUrls()).then(function(r){return r.json()}).then(function(idx){
          var v=idx&&idx.v?String(idx.v):'';
          if(!v) return;
          if(cached&&cached!==v){
            /* 修改点：先写新版本号、后执行 replace；写入失败（隐私模式/配额满）try/catch 兜底并放弃刷新，杜绝无限刷新循环 */
            try{ localStorage.setItem(K,v); }catch(eW){ return; }
            location.replace(location.pathname+"?ycv="+v+"_"+Date.now());
            return;
          }
          if(!cached){ try{ localStorage.setItem(K,v); }catch(eS){} applyV(v); }
        }).catch(function(){ if(!cached){localStorage.setItem(K,FALLBACK);applyV(FALLBACK);} });
      }catch(e){}
    })();
    </script>