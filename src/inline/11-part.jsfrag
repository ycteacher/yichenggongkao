<script>
/* live stats v1: 设备指纹 / 型号 / 新增回访 / 在线心跳 / 安装 → textdb 聚合池
   数据契约 key=ycgk-live-v1，供数据看板实时读取。纯前端，无后端依赖。 */
(function(){
  var KEY='ycgk-live-v1';
  var GETS=['https://textdb.dev/api/data/','https://textdb.online/'];
  var PUTS=[
    function(k,v,cb){fetch('https://textdb.online/update/?key='+encodeURIComponent(k)+'&value='+encodeURIComponent(v)).then(function(){cb(true)},function(){cb(false)})},
    function(k,v,cb){fetch('https://textdb.dev/api/data/'+k,{method:'POST',headers:{'Content-Type':'text/plain'},body:v}).then(function(r){cb(!!r.ok)},function(){cb(false)})}
  ];
  function pad(n){return ('0'+n).slice(-2)}
  function dayKey(d){return ''+d.getFullYear()+pad(d.getMonth()+1)+pad(d.getDate())}
  /* 匿名设备ID：本地生成并长期保存；型号/系统识别 */
  function deviceId(){
    var id='';try{id=localStorage.getItem('ycgk.did')}catch(e){}
    if(!id){
      id='d'+Date.now().toString(36)+Math.random().toString(36).slice(2,8);
      try{localStorage.setItem('ycgk.did',id)}catch(e){}
    }
    return id;
  }
  function parseDevice(){
    var ua=navigator.userAgent||'',os='pc',model='电脑';
    if(/iPhone/i.test(ua)){os='ios';model='iPhone'}
    else if(/iPad/i.test(ua)||(navigator.platform==='MacIntel'&&navigator.maxTouchPoints>1)){os='ios';model='iPad'}
    else if(/iPod/i.test(ua)){os='ios';model='iPod'}
    else if(/HarmonyOS|OpenHarmony|ArkWeb/i.test(ua)){os='harmony';model='鸿蒙设备';var hm=ua.match(/(?:HarmonyOS|ArkWeb)[^;)]*\)?\s*([A-Za-z0-9 \-]{2,20})/i);if(hm&&hm[1])model='鸿蒙 '+hm[1].trim().slice(0,16)}
    else if(/Android/i.test(ua)){
      os='android';
      var br=ua.match(/Build\/([^;)]+)/i);var md=ua.match(/Android[^;)]*;\s*([^;)]+)/i);
      if(md&&md[1])model=md[1].trim().slice(0,20);else if(br)model='Android '+br[1].trim().slice(0,14);else model='安卓设备';
      if(/Pad|Tablet|SM-T\d|MatePad/i.test(ua))model+='(平板)';
    }
    var installed=(window.matchMedia&&matchMedia('(display-mode: standalone)').matches)||navigator.standalone===true;
    return {os:os,model:model,install:!!installed};
  }
  function get(cb){
    var i=0;
    (function next(){
      if(i>=GETS.length){cb(null);return}
      fetch(GETS[i++]+KEY,{cache:'no-store'}).then(function(r){return r.text()}).then(function(t){
        if(!t||t.charAt(0)!=='{'){next();return}
        try{cb(JSON.parse(t))}catch(e){next()}
      }).catch(function(){next()});
    })();
  }
  function put(val,cb){
    var s=JSON.stringify(val);
    /* textdb.dev 实测写入/读回均可靠；直接写它，避免主线路"假成功" */
    PUTS[1](KEY,s,function(ok){cb(ok)});
  }
  function report(){
    var did=deviceId(),dev=parseDevice(),now=Date.now(),today=dayKey(new Date());
    get(function(pool){
      var p=pool&&typeof pool==='object'?pool:{};
      if(!p.online||typeof p.online!=='object')p.online={};
      if(!p.devices||typeof p.devices!=='object')p.devices={};
      /* 清理10分钟前的在线记录，控制体积 */
      Object.keys(p.online).forEach(function(k){if(now-p.online[k]>600000)delete p.online[k]});
      p.online[did]=now;
      /* 分钟级心跳计数：供看板画实时分钟趋势（保留最近3小时） */
      if(!p.min||typeof p.min!=='object')p.min={};
      var mk=today+pad(new Date().getHours())+pad(new Date().getMinutes());
      p.min[mk]=(p.min[mk]||0)+1;
      var mks=Object.keys(p.min).sort();
      if(mks.length>180){for(var mi=0;mi<mks.length-180;mi++)delete p.min[mks[mi]];}
      var rec=p.devices[did]||{};
      if(!rec.first)rec.first=dayKey(new Date());
      rec.last=today;rec.m=dev.model;rec.os=dev.os;rec.inst=!!(rec.inst||dev.install);
      /* 访问频次 + 按天分时活跃：供看板生成真实访问趋势/24小时分布 */
      rec.pv=(rec.pv||0)+1;
      var dObj=new Date(),hr=pad(dObj.getHours());
      if(!rec.hr||typeof rec.hr!=='object')rec.hr={};
      if(!rec.hr[today]||typeof rec.hr[today]!=='object')rec.hr[today]={};
      rec.hr[today][hr]=(rec.hr[today][hr]||0)+1;
      /* 只保留最近14天的分时，控制体积 */
      var hkeys=Object.keys(rec.hr).sort();
      if(hkeys.length>14){for(var hi=0;hi<hkeys.length-14;hi++)delete rec.hr[hkeys[hi]];}
      /* 活跃日矩阵（最近30天）：供留存/回访/DAU 计算 */
      if(!rec.days||typeof rec.days!=='object')rec.days={};
      rec.days[today]=1;
      var dkeys=Object.keys(rec.days).sort();
      if(dkeys.length>30){for(var di=0;di<dkeys.length-30;di++)delete rec.days[dkeys[di]];}
      /* 会话：距上次心跳超过30分钟算新会话 */
      if(!rec.lastTs||now-rec.lastTs>1800000)rec.sess=(rec.sess||0)+1;
      rec.lastTs=now;
      /* 来源渠道（只记首次）+ 页面加载耗时（只记首次） */
      if(!rec.ref){try{var rf=document.referrer||'';if(rf)rec.ref=rf.replace(/^https?:\/\//,'').split(/[/?#]/)[0].slice(0,40)||'直接打开'}catch(e){}}
      if(rec.perf===undefined){try{var t0=performance.timing,tn=performance.navigation?performance.navigation.type:0;if(t0&&t0.domContentLoadedEventStart>0)rec.perf=Math.min(9999,Math.round(t0.domContentLoadedEventStart-t0.navigationStart))}catch(e){rec.perf=0}}
      p.devices[did]=rec;
      /* 设备数上限保护：超过2000台只保留最近1500台 */
      var ids=Object.keys(p.devices);
      if(ids.length>2000){
        ids.sort(function(a,b){return (p.devices[b].last||'')>(p.devices[a].last||'')?1:-1});
        var keep={};for(var i=0;i<1500;i++)keep[ids[i]]=p.devices[ids[i]];
        p.devices=keep;
      }
      p.ts=now;
      put(p,function(){});
    });
  }
  try{ report(); setInterval(report,120000); }catch(e){}
})();
</script>